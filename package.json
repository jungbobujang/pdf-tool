{
  "name": "pdf-tool",
  "version": "1.0.0",
  "description": "PDF 작업실 - 브라우저 안에서만 PDF를 처리하는 웹앱",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/gen-licenses.mjs && node scripts/gen-changelog.mjs",
    "verify": "node test/verify.mjs",
    "test:ui": "node test/ui-check.mjs",
    "screens": "node test/ui-check.mjs --screens",
    "deploy": "node scripts/write-build-info.mjs && railway up --detach"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "express": "4.21.2",
    "heic-to": "1.5.2",
    "jpeg-js": "0.4.4",
    "jszip": "3.10.1",
    "pako": "2.1.0",
    "pdfjs-dist": "3.11.174",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "axe-core": "4.13.0"
  }
}
